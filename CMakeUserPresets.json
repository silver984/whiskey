{
  "version": 9,
  "configurePresets": [
    {
      "name": "clang-cl-config",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}\\build",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang-cl-build",
      "configurePreset": "clang-cl-config"
    }
  ]
}